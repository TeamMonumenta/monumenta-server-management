<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
	"-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
	"https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
	<suppress files=".*[\\/]\w*Adapter_.*\.java"
			  checks="TypeName"
			  message=".*Type name.*must match pattern.*"/>
	<!-- Accessors named like Bukkit's Location.x(); public API, so not renamed -->
	<suppress files=".*[\\/]redissync[\\/]data[\\/]OptionalLocation\.java"
			  checks="MethodName"
			  message=".*Method name '[xyz]' must match pattern.*"/>
</suppressions>
